        "tapio-agent/src/sink/controller.rs",
        "tapio-agent/src/sink/file.rs",
        "tapio-agent/src/sink/http.rs",
        "tapio-agent/src/sink/mod.rs",
        "tapio-agent/src/sink/otlp.rs",
        "tapio-agent/src/sink/stdout.rs",
        "tapio-cli/Cargo.toml",
        "tapio-cli/src/main.rs",
        "tapio-common/Cargo.toml",
        "tapio-common/src/ebpf.rs",
