        "tapio-common/src/lib.rs",
        "tapio-common/src/occurrence.rs",
        "tapio-common/src/sink.rs",
        "tapio-controller/Cargo.toml",
        "tapio-controller/src/lib.rs",
        "tapio-controller/src/main.rs",
        "tapio-profile/Cargo.toml",
        "tapio-profile/src/lib.rs",
        "tapio-wire/Cargo.toml",
        "tapio-wire/src/config.rs",
        "tapio-wire/src/lib.rs"
      ]
    },
